# Public Supabase settings (Project Settings > API)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Supabase key. Never expose this in PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe test-mode keys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET

# Public site URL used for auth redirects, Checkout and Connect onboarding
PUBLIC_SITE_URL=http://localhost:5173

# Dedicated owner administration access (server-only)
ADMIN_EMAIL=owner@example.com
ADMIN_ACCESS_CODE=replace-with-a-long-private-code

# Private Cloudflare R2 package storage (server-only)
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=assetguru-packages
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.eu.r2.cloudflarestorage.com
